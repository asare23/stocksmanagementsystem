// =====================================================================
// Stock Management System — Prisma schema
// Core principle (req. #39/#40): PRODUCTS -> INVENTORY -> INVENTORY_TRANSACTIONS
//   Product   = what the item is
//   Inventory = how much exists at a location (running balance, cached)
//   InventoryTransaction = why the quantity changed (immutable ledger)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// AUTH / USERS / ROLES / PERMISSIONS  (req #2, #36, #37)
// ---------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

model User {
  id               String     @id @default(uuid())
  employeeCode     String?    @unique
  fullName         String
  email            String     @unique
  phone            String?
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  roleId           String
  role             Role       @relation(fields: [roleId], references: [id])
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  approvals          Approval[]             @relation("ApprovalRequestedBy")
  approvalsDecided   Approval[]             @relation("ApprovalDecidedBy")
  auditLogs          AuditLog[]
  notifications      Notification[]
  purchaseOrders     PurchaseOrder[]        @relation("PORequestedBy")
  goodsReceipts      GoodsReceipt[]         @relation("GRNReceivedBy")
  sales              Sale[]                 @relation("SaleCreatedBy")
  payments           Payment[]              @relation("PaymentReceivedBy")
  stockTransfersFrom StockTransfer[]        @relation("TransferRequestedBy")
  stockAdjustments   StockAdjustment[]      @relation("AdjustmentRequestedBy")
  stockCounts        StockCount[]           @relation("StockCountCreatedBy")
  inventoryTxns      InventoryTransaction[] @relation("InvTxnUser")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // SUPER_ADMIN, STOCK_MANAGER, PROCUREMENT_OFFICER, SALES_OFFICER, CASHIER, ACCOUNTANT, AUDITOR (extensible)
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. PRODUCT_CREATE, STOCK_ADJUST, PURCHASE_APPROVE
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------
// ORGANIZATION STRUCTURE (req #3)
// ---------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("GHS")
  taxRate   Decimal  @default(0) @db.Decimal(6, 3) // default VAT %
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  settings SystemSetting[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String   @unique
  name      String
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses Warehouse[]
  users      User[]
  sales      Sale[]

  @@map("branches")
}

model Warehouse {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  code      String   @unique
  name      String
  location  String?
  managerId String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations             WarehouseLocation[]
  inventory             Inventory[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  sales                 Sale[]
  transfersFrom         StockTransfer[]        @relation("TransferFromWarehouse")
  transfersTo           StockTransfer[]        @relation("TransferToWarehouse")
  stockAdjustments      StockAdjustment[]
  stockCounts           StockCount[]
  inventoryTransactions InventoryTransaction[]

  @@map("warehouses")
}

// Bin / rack / shelf locations (req #13) — optional finer-grained location within a warehouse
model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  rack        String?
  shelf       String?
  bin         String?
  createdAt   DateTime  @default(now())

  inventory Inventory[]

  @@map("warehouse_locations")
}

// ---------------------------------------------------------------------
// PRODUCT MANAGEMENT (req #4, #5, #6)
// ---------------------------------------------------------------------

model ProductCategory {
  id       String            @id @default(uuid())
  name     String
  parentId String?
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")

  products Product[]

  @@map("product_categories")
}

model ProductBrand {
  id   String @id @default(uuid())
  name String @unique

  products Product[]

  @@map("product_brands")
}

model ProductUnit {
  id           String @id @default(uuid())
  name         String @unique // e.g. "Piece", "Litre", "Box"
  abbreviation String

  products Product[]

  @@map("product_units")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

model Product {
  id          String           @id @default(uuid())
  sku         String           @unique
  name        String
  description String?
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       ProductBrand?    @relation(fields: [brandId], references: [id])
  unitId      String?
  unit        ProductUnit?     @relation(fields: [unitId], references: [id])
  imageUrl    String?
  status      ProductStatus    @default(ACTIVE)

  // Pricing (req #4.2) — current prices; history kept in ProductPriceHistory (req #27)
  costPrice       Decimal  @default(0) @db.Decimal(14, 2)
  sellingPrice    Decimal  @default(0) @db.Decimal(14, 2)
  wholesalePrice  Decimal? @db.Decimal(14, 2)
  minSellingPrice Decimal? @db.Decimal(14, 2)
  taxRate         Decimal  @default(0) @db.Decimal(6, 3)

  // Inventory configuration (req #4.3) — per-product defaults; actual balances live in Inventory
  minStockLevel   Int  @default(0)
  maxStockLevel   Int?
  reorderLevel    Int  @default(0)
  reorderQuantity Int  @default(0)

  // Tracking flags (req #25, #26)
  isSerialTracked    Boolean @default(false)
  isBatchTracked     Boolean @default(false)
  allowNegativeStock Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  barcodes              ProductBarcode[]
  vehicleCompatibility  ProductVehicleCompatibility[]
  inventory             Inventory[]
  priceHistory          ProductPriceHistory[]
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceiptItems     GoodsReceiptItem[]
  saleItems             SaleItem[]
  customerReturnItems   CustomerReturnItem[]
  supplierReturnItems   SupplierReturnItem[]
  stockTransferItems    StockTransferItem[]
  stockAdjustmentItems  StockAdjustmentItem[]
  stockCountItems       StockCountItem[]
  inventoryTransactions InventoryTransaction[]
  batches               ProductBatch[]
  serials               ProductSerial[]

  @@map("products")
}

model ProductBarcode {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  barcode   String  @unique
  isPrimary Boolean @default(false)

  @@map("product_barcodes")
}

// Price change log (req #27 — "Price changes should be logged and historical prices retained")
model ProductPriceHistory {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  priceType String // COST, SELLING, WHOLESALE, MIN_SELLING
  oldPrice  Decimal  @db.Decimal(14, 2)
  newPrice  Decimal  @db.Decimal(14, 2)
  changedBy String?
  changedAt DateTime @default(now())

  @@map("product_price_history")
}

// Spare-parts vehicle compatibility (req #5)
model VehicleMake {
  id   String @id @default(uuid())
  name String @unique

  models VehicleModel[]

  @@map("vehicle_makes")
}

model VehicleModel {
  id     String      @id @default(uuid())
  makeId String
  make   VehicleMake @relation(fields: [makeId], references: [id])
  name   String

  compatibility ProductVehicleCompatibility[]

  @@map("vehicle_models")
}

model ProductVehicleCompatibility {
  id             String       @id @default(uuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  yearFrom       Int?
  yearTo         Int?
  position       String? // FRONT, REAR
  side           String? // LEFT, RIGHT

  @@map("product_vehicle_compatibility")
}

// Batch tracking (req #26)
model ProductBatch {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  batchNumber     String
  quantity        Int       @default(0)
  manufactureDate DateTime?
  expiryDate      DateTime?
  createdAt       DateTime  @default(now())

  @@unique([productId, batchNumber])
  @@map("product_batches")
}

// Serial number tracking (req #25)
enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  DEFECTIVE
}

model ProductSerial {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  serialNo    String       @unique
  warehouseId String?
  status      SerialStatus @default(IN_STOCK)
  createdAt   DateTime     @default(now())

  @@map("product_serials")
}

// ---------------------------------------------------------------------
// SUPPLIER MANAGEMENT (req #7)
// ---------------------------------------------------------------------

model Supplier {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  country       String?
  taxId         String?
  paymentTerms  String?
  creditLimit   Decimal? @db.Decimal(14, 2)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  supplierReturns SupplierReturn[]
  payments        Payment[]

  @@map("suppliers")
}

// ---------------------------------------------------------------------
// CUSTOMER MANAGEMENT (req #17)
// ---------------------------------------------------------------------

model Customer {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  phone        String?
  email        String?
  address      String?
  customerType String   @default("WALK_IN") // WALK_IN, INDIVIDUAL, RETAIL, WHOLESALE, CORPORATE
  creditLimit  Decimal? @db.Decimal(14, 2)
  paymentTerms String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales           Sale[]
  customerReturns CustomerReturn[]
  payments        Payment[]

  @@map("customers")
}

// ---------------------------------------------------------------------
// PURCHASE ORDER MANAGEMENT (req #8)
// ---------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  CLOSED
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId   String
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now())
  totalAmount   Decimal             @default(0) @db.Decimal(14, 2)
  requestedById String
  requestedBy   User                @relation("PORequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  approvals     Approval[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(14, 2)
  lineTotal        Decimal       @db.Decimal(14, 2)

  goodsReceiptItems GoodsReceiptItem[]

  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------
// GOODS RECEIVED / STOCK IN (req #9)
// ---------------------------------------------------------------------

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  grnNumber       String             @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  status          GoodsReceiptStatus @default(DRAFT)
  receiptDate     DateTime           @default(now())
  receivedById    String
  receivedBy      User               @relation("GRNReceivedBy", fields: [receivedById], references: [id])
  approvedById    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items                 GoodsReceiptItem[]
  inventoryTransactions InventoryTransaction[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String             @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  quantityReceived    Int
  unitCost            Decimal            @db.Decimal(14, 2)
  batchNumber         String?
  serialNumbers       String? // comma-separated for simplicity in MVP
  expiryDate          DateTime?

  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------
// INVENTORY (req #10, #11) — the ledger-based core
// ---------------------------------------------------------------------

// Cached running balance per product/warehouse for fast reads. Bin/rack/shelf location is
// tracked as informational metadata (req #13) — NOT part of the balance key. A nullable field
// inside a composite unique constraint is unsafe in Postgres (NULL never equals NULL, so every
// upsert against a null locationId would silently insert a new row instead of updating the
// existing balance) — so the balance always keyed strictly by product+warehouse.
model Inventory {
  id                String             @id @default(uuid())
  productId         String
  product           Product            @relation(fields: [productId], references: [id])
  warehouseId       String
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  primaryLocationId String?
  primaryLocation   WarehouseLocation? @relation(fields: [primaryLocationId], references: [id])
  quantityOnHand    Int                @default(0)
  quantityReserved  Int                @default(0)
  updatedAt         DateTime           @updatedAt

  @@unique([productId, warehouseId])
  @@map("inventory")
}

enum InventoryTxnType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  OPENING_STOCK
  REVERSAL
}

// Immutable ledger — every stock movement, ever (req #11, #33, #49)
model InventoryTransaction {
  id             String           @id @default(uuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id])
  txnType        InventoryTxnType
  quantityIn     Int              @default(0)
  quantityOut    Int              @default(0)
  balanceAfter   Int // running balance at this warehouse after this txn
  unitCost       Decimal?         @db.Decimal(14, 2)
  reference      String // e.g. GRN number, invoice number, transfer number
  sourceType     String // PURCHASE, SALE, TRANSFER, RETURN, ADJUSTMENT, STOCK_COUNT, OPENING
  sourceId       String? // id of the source record
  isReversal     Boolean          @default(false)
  reversedTxnId  String?
  goodsReceiptId String?
  goodsReceipt   GoodsReceipt?    @relation(fields: [goodsReceiptId], references: [id])
  userId         String
  user           User             @relation("InvTxnUser", fields: [userId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([productId, warehouseId])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------
// STOCK TRANSFER (req #14)
// ---------------------------------------------------------------------

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String         @id @default(uuid())
  transferNumber  String         @unique
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  status          TransferStatus @default(DRAFT)
  requestedById   String
  requestedBy     User           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items     StockTransferItem[]
  approvals Approval[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(uuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int

  @@map("stock_transfer_items")
}

// ---------------------------------------------------------------------
// SALES / POS / INVOICES (req #15, #16, #24, #43)
// ---------------------------------------------------------------------

enum SaleStatus {
  DRAFT
  COMPLETED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REVERSED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERPAID
}

model Sale {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  salesPersonId String
  salesPerson   User          @relation("SaleCreatedBy", fields: [salesPersonId], references: [id])
  status        SaleStatus    @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  saleDate      DateTime      @default(now())

  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  discount   Decimal @default(0) @db.Decimal(14, 2)
  tax        Decimal @default(0) @db.Decimal(14, 2)
  total      Decimal @default(0) @db.Decimal(14, 2)
  amountPaid Decimal @default(0) @db.Decimal(14, 2)
  balance    Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           SaleItem[]
  payments        Payment[]
  customerReturns CustomerReturn[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  tax       Decimal @default(0) @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)

  customerReturnItems CustomerReturnItem[]

  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  CREDIT
  BANK_TRANSFER
}

model Payment {
  id           String        @id @default(uuid())
  reference    String        @unique
  saleId       String?
  sale         Sale?         @relation(fields: [saleId], references: [id])
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(14, 2)
  receivedById String
  receivedBy   User          @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  paidAt       DateTime      @default(now())

  @@map("payments")
}

// ---------------------------------------------------------------------
// RETURNS (req #18, #19)
// ---------------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  COMPLETED
  REJECTED
}

model CustomerReturn {
  id            String       @id @default(uuid())
  returnNumber  String       @unique
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  status        ReturnStatus @default(REQUESTED)
  reason        String?
  requestedById String
  approvedById  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items     CustomerReturnItem[]
  approvals Approval[]

  @@map("customer_returns")
}

model CustomerReturnItem {
  id               String         @id @default(uuid())
  customerReturnId String
  customerReturn   CustomerReturn @relation(fields: [customerReturnId], references: [id])
  saleItemId       String?
  saleItem         SaleItem?      @relation(fields: [saleItemId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Int
  condition        String? // RESALABLE, DAMAGED

  @@map("customer_return_items")
}

model SupplierReturn {
  id             String       @id @default(uuid())
  returnNumber   String       @unique
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  goodsReceiptId String?
  status         ReturnStatus @default(REQUESTED)
  reason         String?
  requestedById  String
  approvedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items     SupplierReturnItem[]
  approvals Approval[]

  @@map("supplier_returns")
}

model SupplierReturnItem {
  id               String         @id @default(uuid())
  supplierReturnId String
  supplierReturn   SupplierReturn @relation(fields: [supplierReturnId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Int

  @@map("supplier_return_items")
}

// ---------------------------------------------------------------------
// STOCK ADJUSTMENT (req #20)
// ---------------------------------------------------------------------

enum AdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  REVERSED
}

enum AdjustmentReason {
  DAMAGED
  LOST
  EXPIRED
  THEFT
  COUNTING_ERROR
  DATA_CORRECTION
  OPENING_BALANCE
}

model StockAdjustment {
  id               String           @id @default(uuid())
  adjustmentNumber String           @unique
  warehouseId      String
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  reason           AdjustmentReason
  status           AdjustmentStatus @default(DRAFT)
  requestedById    String
  requestedBy      User             @relation("AdjustmentRequestedBy", fields: [requestedById], references: [id])
  approvedById     String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items     StockAdjustmentItem[]
  approvals Approval[]

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String          @id @default(uuid())
  stockAdjustmentId String
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantityBefore    Int
  quantityAdjusted  Int // positive = increase, negative = decrease

  @@map("stock_adjustment_items")
}

// ---------------------------------------------------------------------
// STOCK TAKING / PHYSICAL INVENTORY (req #21)
// ---------------------------------------------------------------------

enum StockCountStatus {
  DRAFT
  LOCKED
  COUNTING
  REVIEW
  APPROVED
  COMPLETED
  CANCELLED
}

model StockCount {
  id           String           @id @default(uuid())
  countNumber  String           @unique
  warehouseId  String
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  status       StockCountStatus @default(DRAFT)
  createdById  String
  createdBy    User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  items StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id               String     @id @default(uuid())
  stockCountId     String
  stockCount       StockCount @relation(fields: [stockCountId], references: [id])
  productId        String
  product          Product    @relation(fields: [productId], references: [id])
  systemQuantity   Int
  physicalQuantity Int?
  difference       Int?

  @@map("stock_count_items")
}

// ---------------------------------------------------------------------
// APPROVALS (req #34) — generic approval record, polymorphic-ish via type+refId
// ---------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id            String         @id @default(uuid())
  entityType    String // PURCHASE_ORDER, STOCK_ADJUSTMENT, STOCK_TRANSFER, CUSTOMER_RETURN, SUPPLIER_RETURN, DISCOUNT, REVERSAL
  entityId      String
  status        ApprovalStatus @default(PENDING)
  requestedById String
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime       @default(now())

  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  stockTransferId   String?
  stockTransfer     StockTransfer?   @relation(fields: [stockTransferId], references: [id])
  stockAdjustmentId String?
  stockAdjustment   StockAdjustment? @relation(fields: [stockAdjustmentId], references: [id])
  customerReturnId  String?
  customerReturn    CustomerReturn?  @relation(fields: [customerReturnId], references: [id])
  supplierReturnId  String?
  supplierReturn    SupplierReturn?  @relation(fields: [supplierReturnId], references: [id])

  @@map("approvals")
}

// ---------------------------------------------------------------------
// DISCOUNTS (req #28)
// ---------------------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Discount {
  id               String       @id @default(uuid())
  name             String
  type             DiscountType
  value            Decimal      @db.Decimal(14, 2)
  productId        String?
  customerId       String?
  requiresApproval Boolean      @default(false)
  active           Boolean      @default(true)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime     @default(now())

  @@map("discounts")
}

// ---------------------------------------------------------------------
// NOTIFICATIONS (req #35)
// ---------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String // LOW_STOCK, OUT_OF_STOCK, PENDING_APPROVAL, PENDING_PO, TRANSFER_AWAITING, EXPIRING_PRODUCT, OVERDUE_PAYMENT, SUPPLIER_PAYMENT_DUE, FAILED_TRANSACTION
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ---------------------------------------------------------------------
// AUDIT TRAIL (req #32)
// ---------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // LOGIN, LOGOUT, PRODUCT_CREATE, SALE, ADJUSTMENT, APPROVAL, REVERSAL, ...
  entityType String?
  entityId   String?
  oldValue   String? // JSON string
  newValue   String? // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// SYSTEM SETTINGS (req #47)
// ---------------------------------------------------------------------

model SystemSetting {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
